<header class="site-header">
  {#- The home hero already shows the name, so the header only carries it on other pages. #}
  {%- if page.url != "/" %}<a class="site-name" href="/">{{ site.name }}</a>{% else %}<span></span>{% endif %}
  <nav>
    {%- for item in site.nav %}
    {%- set active = (page.url == item.url) or (page.url and item.url != "/" and page.url.startsWith(item.url)) %}
    <a href="{{ item.url }}"{% if active %} aria-current="page"{% endif %}>{{ item.label }}</a>
    {%- endfor %}
    <button class="theme-toggle" type="button" aria-label="Toggle dark mode">
      <svg class="icon-moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
      <svg class="icon-sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
    </button>
  </nav>
</header>

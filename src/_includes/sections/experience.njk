<section>
  <h2>Experience</h2>
  <ul class="rows entries">
    {%- for e in experience %}
    <li>
      <div class="row">
        <span><span class="row-title">{{ e.role }}</span><span class="row-org">{{ e.org }}</span></span>
        <span class="row-date">{{ e.start }}–{{ e.end }}</span>
      </div>
      {%- if e.bullets %}
      <ul class="row-bullets">
        {%- for b in e.bullets %}<li>{{ b }}</li>{% endfor %}
      </ul>
      {%- endif %}
    </li>
    {%- endfor %}
  </ul>
</section>

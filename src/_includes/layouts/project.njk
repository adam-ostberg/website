---
layout: layouts/base.njk
wide: true
---
<article class="project">
  <p class="back"><a href="/projects/">← Projects</a></p>
  <h1>{{ title }}</h1>
  <p class="meta">{{ page.date | yearRange(end) }}{% if stack %} · {{ stack | join(" · ") }}{% endif %}</p>
  {% if summary %}<p class="lede">{{ summary }}</p>{% endif %}
  {% include "partials/project-links.njk" %}
  <div class="prose">
    {{ content | safe }}
  </div>
</article>

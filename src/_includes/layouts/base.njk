<!doctype html>
<html lang="{{ site.lang }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  {%- set pageTitle = (title + " · " + site.name) if (title and page.url != "/") else site.name %}
  {%- set pageDescription = summary or site.description %}
  {%- set pageUrl = site.url + page.url %}
  <title>{{ pageTitle }}</title>
  <meta name="description" content="{{ pageDescription }}">
  <link rel="canonical" href="{{ pageUrl }}">
  <meta name="color-scheme" content="light dark">
  {#- Favicon: "AÖ" in Caveat. favicon.ico holds 16/32/48 px; iOS uses the apple-touch-icon. #}
  <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png">
  {#- Link previews (LinkedIn, Slack, iMessage...). A project uses its own image; other pages share a 1200x630 card. #}
  <meta property="og:type" content="{{ 'website' if page.url == '/' else 'article' }}">
  <meta property="og:site_name" content="{{ site.name }}">
  <meta property="og:title" content="{{ pageTitle }}">
  <meta property="og:description" content="{{ pageDescription }}">
  <meta property="og:url" content="{{ pageUrl }}">
  {%- set ogImage = (previewImage or image) | ogImage %}
  {%- set ownImage = ogImage != "/assets/img/og-card.png" %}
  <meta property="og:image" content="{{ site.url }}{{ ogImage }}">
  {%- if not ownImage %}
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  {%- endif %}
  <meta property="og:image:alt" content="{{ (imageAlt if ownImage and imageAlt) or (site.name + ', ' + site.tagline) }}">
  <meta name="twitter:card" content="summary_large_image">
  <script>
    // Apply a saved theme before first paint to avoid a flash.
    try { const t = localStorage.getItem("theme"); if (t) document.documentElement.dataset.theme = t; } catch (e) {}
  </script>
  {#- Self-hosted Caveat (name only). Preloaded so the name doesn't flash in the fallback font. #}
  <link rel="preload" href="/assets/fonts/caveat-latin-600-normal.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="/assets/css/style.css?v={{ assetVersion }}">
  <script src="/assets/js/theme.js?v={{ assetVersion }}" defer></script>
  {%- if wide %}
  <script src="/assets/js/toc.js?v={{ assetVersion }}" defer></script>
  {%- endif %}
</head>
<body>
  <div class="page{% if wide %} page--wide{% endif %}">
  {%- if wide %}{% include "partials/side-nav.njk" %}{% endif %}
  <div class="sheet">
    {% include "partials/header.njk" %}
    <main>
      {{ content | safe }}
    </main>
    {% include "partials/footer.njk" %}
  </div>
  {%- if wide %}
  <!--toc-->
  {%- endif %}
  </div>
</body>
</html>
